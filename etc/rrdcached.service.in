#
# To customize, copy this file to /etc/systemd/system/
# and edit there
#

[Unit]
Description=Data caching daemon for rrdtool
Documentation=man:rrdcached(1)
# the service gets its socket from rrdcached.socket (-g, no -l)
Requires=rrdcached.socket
After=rrdcached.socket

[Service]
# If you enable socket-activable rrdcached.socket,
# command line socket declarations will be ignored
#
# -B -b: only touch files below /var/lib/rrdcached/db (relative paths are
#        taken from there); -O: CREATE never overwrites an existing file.
# The rest of the file system is read-only to the daemon. To keep your
# RRD files elsewhere, point -b there and add the directory to
# ReadWritePaths= (and give User= access to it if you set one).
# The pid file goes to the state directory, which is writable.
ExecStart=@bindir@/rrdcached -g -B -O -b /var/lib/rrdcached/db -j /var/lib/rrdcached/journal -p /var/lib/rrdcached/rrdcached.pid
StateDirectory=rrdcached rrdcached/db rrdcached/journal
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No NoNewPrivileges=: it stops the SELinux transition into rrdcached_t,
# leaving the daemon in systemd's own domain (see rrdcached(1), SELinux).
#ReadWritePaths=
#User=
#Group=

[Install]
WantedBy=multi-user.target
