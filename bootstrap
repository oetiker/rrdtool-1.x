#!/usr/bin/env bash

# On MAC OS X, GNU libtoolize is named 'glibtoolize':
if [ `(uname -s) 2>/dev/null` = 'Darwin' ]
then
	glibtoolize
else
	libtoolize
fi

# Only generate the build system; run ./configure and make yourself.
# (autoreconf --make would rerun configure and make in a configured tree.)
autoreconf --force --install --verbose -I m4
