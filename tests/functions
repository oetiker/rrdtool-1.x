set -x
TZ=Europe/Zurich
export TZ

# Use dot as decimal separator, which is required for some tests to pass
LC_NUMERIC=C
export LC_NUMERIC

BASEDIR="${BASEDIR:-$(dirname -- $0)}"
BASEDIR="$(readlink -f -- $BASEDIR)"

BUILDDIR="${BUILDDIR:-${BASEDIR}}"
TOP_BUILDDIR="${TOP_BUILDDIR:-${BASEDIR}/..}"

DIFF="diff -u"
DIFF9=seddif

# On Windows, names of times zones are different. Substitute Windows tz names with numeric offsets.
function seddif {
   perl -p -e 's/([-+]?\d\.\d+e[-+]\d+)/sprintf("%0.7e",$1)/ge; s/W\. Europe Standard Time/+0100/g; s/W\. Europe Daylight Time/+0200/g' | $DIFF $@
}

BLANK=blank

function blank {
   perl -p -e 'm/(left|top|right|bottom|width|height|coords)/ && s/\d+/\#/g' $@
}

#
# because valgrind has trouble with glib memory handling
# (see e.g. https://developer.gnome.org/glib/2.30/glib-running.html or 
# https://stackoverflow.com/questions/4254610/valgrind-reports-memory-possibly-lost-when-using-glib-data-types)
# we set some env. vars to work around them:

VALGRIND_ERR_FILE="${BASEDIR}/$(basename $0)-valgrind-err.tmp"
if [ -e "$VALGRIND_ERR_FILE" ]; then
  rm "$VALGRIND_ERR_FILE"
fi

# collect_valgrind_logs
#
# Valgrind writes one log per process (--log-file with %p), so a process
# that forks, like the rrdcached daemon, keeps its own log.  Append every
# log of a process that has exited (valgrind ends the log with the ERROR
# SUMMARY line) to $VALGRIND_LOGFILE and remove it; the log of a process
# still running, such as the daemon, stays until a later call.  Print the
# summary of each log with errors to stderr and return 1 if there was one.
function collect_valgrind_logs {
    local LOG RC=0
    [ -n "$VALGRIND_LOGFILE" ] || return 0
    for LOG in "${VALGRIND_LOGFILE}".*.tmp ; do
        [ -e "$LOG" ] || continue
        grep -q '^==[0-9]*== ERROR SUMMARY:' -- "$LOG" || continue
        cat -- "$LOG" >> "$VALGRIND_LOGFILE"
        if grep -q '^==[0-9]*== ERROR SUMMARY: [1-9]' -- "$LOG" ; then
            sed -n '/== Command:/p;/LEAK SUMMARY:/,$p' -- "$LOG" >&2
            RC=1
        fi
        rm -f -- "$LOG"
    done
    return $RC
}

function valgrind {
  # use a sub shell, so setting environment variables only affects the current
  # rrdtool run and not subsequent ones
  local CMD="$1"
  shift
  (
    G_DEBUG=gc-friendly
    G_SLICE=all

    export G_DEBUG 
    export G_SLICE

    VALGRIND_OPTS=
    if [ -n "$VALGRIND_LOGFILE" ] ; then
        # %p: every process, also a forked child, gets a log of its own
        VALGRIND_OPTS=--log-file="${VALGRIND_LOGFILE}.%p.tmp"
    fi

    libtool --mode=execute valgrind --tool=memcheck \
			--suppressions="$BASEDIR/valgrind-supressions" \
			--leak-check=full --show-reachable=yes \
			--leak-resolution=high --num-callers=20 \
			--error-exitcode=111 \
			--track-fds=yes \
                        --track-origins=yes \
			--free-fill=ad \
                        $VALGRIND_OPTS \
			"$CMD" "$@"
    RC=$?

    # Errors of a process other than the one started here, such as a
    # forked child that has exited, do not show in RC.
    collect_valgrind_logs || touch "$VALGRIND_ERR_FILE"

    # make sure to properly report the rrdtool exit code to the caller by:
    #  - first: exiting with the original exit code from the subshell and
    exit $RC
  )
  #    - second: by returning the subshell exit code to the function caller
  #   Also create a file, in case the caller has difficulty testing the rc.
  local RC=$?
  if [ "$RC" == 111 ]; then
    touch "$VALGRIND_ERR_FILE"
  fi
  return $RC
}

function verbose_rrdtool {
	echo "$RRDTOOL_V" "$@" >&2
	"$RRDTOOL_V" "$@"
}

# Number of failed checks so far.  fail exits at once unless CONTINUE
# or INTERACTIVE is set; then it returns 1 and a test can use FAILURES
# for its result.
FAILURES=0

# fail STATUS MESSAGE...
# STATUS is the exit status of the failed command, usually $?.
function fail {
	RC="$1"
	shift

	FAILURES=$((FAILURES + 1))
	echo >&2 "FAILED: (rc=$RC)" "$@"
	if [ -n "$CONTINUE" ] ; then
		return 1
	fi
	if [ -n "$INTERACTIVE" ] ; then
		read -p "Continue? (y/n)" YN
		if [ "$YN" != 'y' ] ; then 
			exit 1
		fi
	else
		exit 1
	fi
	return 1
}

function ok {
	echo >&2 "OK:" "$@"
}

# report [-s STATUS] MESSAGE...
#
# Print OK or FAILED for the exit status of the command that ran just
# before report ($?).  Every command substitution in the arguments, such as
# report "got $(cat out)", runs before report starts and replaces $?, so a
# failed check would be reported as OK.  When the message needs a command
# substitution, pass the status first; $? is expanded before the rest:
#	[ "$got" = 3 ] ; report -s $? "got 3 ($(cat out))"
function report {
	RC=$?
	if [ "$1" = "-s" ]; then
		RC="$2"
		shift 2
	fi
	if [ -e "$VALGRIND_ERR_FILE" ]; then
		RC="valgrind error"
		rm "$VALGRIND_ERR_FILE"
	fi

	if [ "$RC" = 0 ] ; then
		ok "$@"
	else
		fail "$RC" "$@"
	fi


}

# Skip the calling test (automake exit code 77) when rrdtool was built
# with --disable-rrd_graph.
function require_graph {
	if "$TOP_BUILDDIR/src/rrdtool" graph - 2>&1 | grep -q "compiled without graphics" ; then
		echo >&2 "SKIP: rrdtool was built without graph support"
		exit 77
	fi
}

# Skip the calling test when rrdtool was built with --disable-rrd_restore.
function require_restore {
	if "$TOP_BUILDDIR/src/rrdtool" restore /dev/null "$BUILDDIR/require-restore.rrd" 2>&1 |
	    grep -q "compiled without XML import" ; then
		echo >&2 "SKIP: rrdtool was built without restore support"
		exit 77
	fi
}

# Skip the calling test when rrdcached was not built (--disable-rrdcached).
function require_rrdcached {
	if [ ! -x "$TOP_BUILDDIR/src/rrdcached" ] ; then
		echo >&2 "SKIP: rrdcached was not built"
		exit 77
	fi
}

function run_cached {
        local D="$1"
        local CACHED="${D:-$RRDCACHED}"

        stop_cached

        local ADDR
        [ -z "$RRDCACHED_SOCK" ] && RRDCACHED_SOCK="unix"

        # cached/ holds links to the reference files. The git tree has
        # them; a separate build directory or a tarball build does not,
        # so make the missing ones (distclean removes them again).
        mkdir -p "${BUILDDIR}/cached"
        local ref
        for ref in "$BASEDIR"/*.output "$BASEDIR"/*.dump "$BASEDIR/valgrind-supressions"; do
            [ -e "$ref" ] || continue
            [ -e "${BUILDDIR}/cached/$(basename "$ref")" ] ||
                ln -s "$ref" "${BUILDDIR}/cached/" 2>/dev/null
        done

        if [ $RRDCACHED_SOCK == "unix" ]; then
            export BASEDIR="${BUILDDIR}/cached"
            export BUILDDIR="${BASEDIR}"
            make_sock_dir
            ADDR="unix:$RRDTEST_SOCKDIR/$(basename $0)-rrdcached.sock"
        else
            export BASEDIR="${BUILDDIR}/cached"
            export RRDCACHED_STRIPPATH="${BUILDDIR}"

            function RRDTOOLCOMPAT() {
                RRDCACHED_STRIPPATH=${BUILDDIR}
                RRDTOOL_ORIG=$TOP_BUILDDIR/src/rrdtool
                ARGS=("$@")

                # rrdcached does not support update with remote template
                if [ $1 == "update" ] && [ $3 == '--template' ]; then
                    RRDCACHED_STRIPPATH=${BASEDIR}
                    ARGS=( $(sed "s#${BUILDDIR}#${BASEDIR}#" <<< "${ARGS[@]}") )
                fi

                # rrdcached does not support remote restore
                if [ $1 == "restore" ]; then
                    ARGS=( "restore" "$2" $(sed "s#${BUILDDIR}#${BASEDIR}#" <<< $3) )
                    RRDCACHED_STRIPPATH=${BASEDIR}
                fi

                # rrdcached does not support tune
                # if [ $1 == "tune" ]; then
                #     ARGS=( $(sed "s#${BUILDDIR}#${BASEDIR}#" <<< "${ARGS[@]}") )
                # fi

                # rrdcached does not support create with remote source or template
                if [ $1 == "create" ]; then
                    NEWARGS=()
                    IS_NEXT_SOURCE_TEMPLATE=0
                    for arg in $(echo "${ARGS[@]}"); do
                        if [ $IS_NEXT_SOURCE_TEMPLATE == "1" ]; then
                            arg=$(sed "s#${BUILDDIR}#${BASEDIR}#" <<< $arg)
                            IS_NEXT_SOURCE_TEMPLATE=0
                        fi
                        ([ $arg == "--source" ] || [ $arg == "--template" ]) && IS_NEXT_SOURCE_TEMPLATE=1
                        NEWARGS+="$arg "
                    done
                    ARGS=( ${NEWARGS[@]} )
                fi

                $RRDTOOL_ORIG "${ARGS[@]}"
                ret=$?

                if [ $1 == "update" ]; then
                    RRDCACHED_STRIPPATH=${BUILDDIR} $RRDTOOL_ORIG flushcached $2 || fail flushcached
                fi

                return $ret
            }
            export RRDTOOL=RRDTOOLCOMPAT

            port=$(python3 -S << HERE
import socketserver
s = socketserver.TCPServer(("localhost", 0), None)
print(s.server_address[1])
s.server_close()
HERE
)
            ADDR="localhost:$port"
        fi

        CACHED_PID_FILE="$BASEDIR/$(basename $0)-rrdcached.pid"

        $CACHED -p "$CACHED_PID_FILE" -l "$ADDR" -b "$(readlink -f -- $BASEDIR)" -F -B

        RRDCACHED_ADDRESS=$ADDR
        export RRDCACHED_ADDRESS

        sleep 1
        trap 'stop_cached_at_exit' EXIT
}

function stop_cached {
        if [ -n "$CACHED_PID_FILE" ] ; then
                local PID=$(cat "$CACHED_PID_FILE")
                kill $PID
                if [ -n "$VALGRIND_LOGFILE" ] ; then
                        # valgrind writes the daemon's report as it exits
                        wait_for_exit "$PID" 60
                        collect_valgrind_logs || touch "$VALGRIND_ERR_FILE"
                fi
                rm -f -- "$CACHED_PID_FILE"
                CACHED_PID_FILE=""
                RRDCACHED_ADDRESS=""
        fi
        remove_sock_dir
}

# wait_for_exit PID SECONDS
# Wait until process PID has gone.  If it is still there after SECONDS,
# its valgrind report cannot be checked: touch $VALGRIND_ERR_FILE.
function wait_for_exit {
        local PID="$1" N=$(( $2 * 10 ))
        while kill -0 "$PID" 2>/dev/null ; do
                if [ $N -le 0 ] ; then
                        echo >&2 "process $PID did not exit within $2s"
                        touch "$VALGRIND_ERR_FILE"
                        return 1
                fi
                N=$(( N - 1 ))
                sleep 0.1
        done
        return 0
}

# EXIT trap of run_cached: stop the daemon, and fail the test on valgrind
# errors no report call has turned into a failure yet, such as those of
# the daemon, which only show once it has stopped.
function stop_cached_at_exit {
        local RC=$?
        stop_cached
        exit_checking_valgrind $RC
}

# exit_checking_valgrind RC
# End an EXIT trap: exit with RC, or with 1 if a valgrind error is still
# pending that no report call has turned into a failure yet.
function exit_checking_valgrind {
        local RC="$1"
        if [ -e "$VALGRIND_ERR_FILE" ] ; then
                rm -f -- "$VALGRIND_ERR_FILE"
                echo >&2 "FAILED: valgrind error"
                [ "$RC" = 0 ] && RC=1
        fi
        exit $RC
}

# stop_own_cached PIDFILE...
# Stop the rrdcached daemons a test started itself with -p PIDFILE rather
# than through run_cached.  Under valgrind-logfile a plain kill is not
# enough: valgrind writes the daemon's report only as the daemon exits,
# when the test may be gone.  So wait for each daemon to exit and collect
# its report; a report with errors leaves $VALGRIND_ERR_FILE behind for
# exit_checking_valgrind.  Call it in the EXIT trap before the daemon's
# files are removed:
#	trap 'RC=$?; stop_own_cached "$PIDFILE"; rm -rf "$W"; exit_checking_valgrind $RC' EXIT
function stop_own_cached {
        local PIDFILE PID PIDS=()
        for PIDFILE in "$@" ; do
                [ -f "$PIDFILE" ] || continue
                PID=$(cat -- "$PIDFILE")
                [ -n "$PID" ] || continue
                kill $PID 2>/dev/null && PIDS+=("$PID")
        done
        if [ -n "$VALGRIND_LOGFILE" ] ; then
                for PID in "${PIDS[@]}" ; do
                        wait_for_exit "$PID" 60
                done
                collect_valgrind_logs || touch "$VALGRIND_ERR_FILE"
        fi
}

# A unix socket path must be shorter than sizeof(sun_path): 108 bytes on
# Linux, 104 on BSD and macOS. A build directory can be deeper than that,
# so test sockets live in a short directory of their own, one per test
# run, created here and removed by remove_sock_dir (called by stop_cached).
function make_sock_dir {
        [ -n "$RRDTEST_SOCKDIR" ] && [ -d "$RRDTEST_SOCKDIR" ] && return
        local base="${TMPDIR:-/tmp}"
        # leave room for the socket name in the directory
        [ ${#base} -gt 40 ] && base=/tmp
        RRDTEST_SOCKDIR=$(mktemp -d "$base/rrdtest.XXXXXX") \
                || fail 1 "cannot create a socket directory in $base"
}

function remove_sock_dir {
        if [ -n "$RRDTEST_SOCKDIR" ] && [ -d "$RRDTEST_SOCKDIR" ] ; then
                rm -f -- "$RRDTEST_SOCKDIR"/*.sock
                rmdir -- "$RRDTEST_SOCKDIR"
        fi
        RRDTEST_SOCKDIR=""
}

function is_cached {
        [ -n "$RRDCACHED_ADDRESS" ]
}

function exit_if_cached_running {
        local E="$1"
        local MSG="$2"
        if is_cached ; then
                echo >&2 "$MSG"
                exit ${E:-1}
        fi
}

if [ -z "$RRDTOOL" ] ; then 
        RRDTOOL=$TOP_BUILDDIR/src/rrdtool
        RRDCACHED=$TOP_BUILDDIR/src/rrdcached

        NEED_CACHED=
        for ST in $TESTS_STYLE ; do
                case "$ST" in
                rrdcached-unix)
                        NEED_CACHED=1
                        STANDARD_RRDCACHED="$RRDCACHED"
                        RRDCACHED_SOCK=unix
                        ;;
                rrdcached-tcp)
                        NEED_CACHED=1
                        STANDARD_RRDCACHED="$RRDCACHED"
                        RRDCACHED_SOCK=tcp
                        ;;
                valgrind)
                        RRDTOOL="valgrind $TOP_BUILDDIR/src/rrdtool"
                        RRDCACHED="valgrind $TOP_BUILDDIR/src/rrdcached"
                        ;;
                valgrind-logfile)
                        RRDTOOL="valgrind $TOP_BUILDDIR/src/rrdtool"
                        RRDCACHED="valgrind $TOP_BUILDDIR/src/rrdcached"
                        VALGRIND_LOGFILE="${BASEDIR}/$(basename $0)"-valgrind.log
                        rm -f -- "$VALGRIND_LOGFILE" "$VALGRIND_LOGFILE".*.tmp
                        ;;
                *)
                        ;;
                esac
        done
        if [ -n "$NEED_CACHED" ] ; then
                run_cached "$STANDARD_RRDCACHED"
        fi
fi

if [ -n "$VERBOSE" ] ; then
	RRDTOOL_V="$RRDTOOL"
	RRDTOOL=verbose_rrdtool
fi

# Tests name their RRD files by $BUILDDIR paths, but some touch the files
# directly (cp, rm, test -f).  Those must use $RRDDIR: in a VPATH build
# $BASEDIR is the read-only source directory, and with rrdcached over TCP
# the daemon strips $BUILDDIR and keeps the files in its base directory,
# $BASEDIR.  Expected output files always come from $BASEDIR.
if [ -n "$RRDCACHED_STRIPPATH" ] ; then
	RRDDIR="$BASEDIR"
else
	RRDDIR="$BUILDDIR"
fi
