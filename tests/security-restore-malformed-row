#!/bin/bash

. "$(dirname "$0")/functions"

require_restore
[ -n "$RRDCACHED_ADDRESS" ] && exit 77
WORK=$(mktemp -d "$BUILDDIR/restore-bounds.XXXXXX") || fail 1 mktemp
BUILD="$WORK/test"
trap 'rm -rf "$WORK"' EXIT

# Two well-formed database blocks in one RRA must be rejected. Re-entering
# the database parser used to reset the allocation base while retaining the
# first block's row count, leading to out-of-bounds row rotation.
FIXTURE="$(dirname "$0")/security-restore-malformed-row.xml"

$RRDTOOL restore -f "${FIXTURE}" "${BUILD}-out.rrd" >"${BUILD}.out" 2>&1
RESTORE_RC=$?
if [ "$RESTORE_RC" -eq 0 ]; then
  fail 1 "restore of malformed row XML was accepted"
fi
if [ "$RESTORE_RC" -ge 128 ]; then
  fail 1 "restore crashed (exit $RESTORE_RC, signal $((RESTORE_RC - 128))) instead of rejecting cleanly"
fi
if [ -e "${BUILD}-out.rrd" ]; then
  fail 1 "restore left a partial output file behind after rejecting malformed input"
fi
grep -q 'multiple database elements' "${BUILD}.out" || \
  fail 1 "duplicate database was not diagnosed"
report "reject duplicate database without corrupting memory"

# Cover the distinct path where XML parsing reaches EOF without an explicit
# </database> element and without entering the loop body's status exit.
sed '/<\/database>/,$d' "$(dirname "$0")/tune1-testorg.dump" \
  >"${BUILD}-truncated.xml"
$RRDTOOL restore -f "${BUILD}-truncated.xml" "${BUILD}-eof.rrd" \
  >"${BUILD}-eof.out" 2>&1
RESTORE_RC=$?
if [ "$RESTORE_RC" -eq 0 ]; then
  fail 1 "restore accepted XML without a database end tag"
fi
if [ "$RESTORE_RC" -ge 128 ]; then
  fail 1 "restore crashed on truncated XML"
fi
if [ -e "${BUILD}-eof.rrd" ]; then
  fail 1 "restore left output after rejecting truncated XML"
fi
report "reject database without an end tag"
