#!/bin/bash

# rrdtool tune --smoothing-window lifts a version 0003 RRD to 0004.
# Version 0003 smooths every SEASONAL and DEVSEASONAL RRA with a window
# of 0.05 and ignores the stored value; a restored 0003 dump stores 0.
# After the tune, the RRA the option does not name must keep 0.05.

. $(dirname $0)/functions

BUILD=$BUILDDIR/$(basename $0)-test

rm -f ${BUILD}a.xml ${BUILD}r.rrd
$RRDTOOL create ${BUILD}a.rrd --start 1300000000 --step 60 \
	DS:a:GAUGE:120:0:U RRA:AVERAGE:0.5:1:100 \
	RRA:HWPREDICT:100:0.5:0.5:20
report create
$RRDTOOL dump ${BUILD}a.rrd ${BUILD}a.xml
report dump
$RRDTOOL restore ${BUILD}a.xml ${BUILD}r.rrd
report restore

$RRDTOOL tune ${BUILD}r.rrd --smoothing-window 0.1 > /dev/null
report "tune --smoothing-window"
$RRDTOOL info ${BUILD}r.rrd > ${BUILD}r-info.out
report info

grep -q '^rrd_version = "0004"$' ${BUILD}r-info.out
report "tuned RRD has version 0004"
grep -q '^rra\[2\]\.smoothing_window = 1\.0000000000e-01$' ${BUILD}r-info.out
report "SEASONAL smoothing window is 0.1"
grep -q '^rra\[3\]\.smoothing_window = 5\.0000000000e-02$' ${BUILD}r-info.out
report "DEVSEASONAL smoothing window stays 0.05"

rm -f ${BUILD}a.xml ${BUILD}r-info.out
