#!/bin/bash

. "$(dirname "$0")/functions"

# Header fields that rrd_open must check before any consumer uses them:
# the pdp_cnt * pdp_step product, the RRA row pointer, and the fixed-size
# strings that are printed with %s.
[ -n "$RRDCACHED_ADDRESS" ] && exit 77
[ -n "$MSYSTEM" ] && exit 77 # getconf describes MSYS, not the MinGW binary.
test "$(getconf LONG_BIT)" = 64 || exit 77

BUILD="$BUILDDIR/$(basename "$0")"

$RRDTOOL create "${BUILD}.rrd" --start 900000000 --step 60 \
  DS:value:GAUGE:120:U:U RRA:AVERAGE:0.5:1:2 || fail $? create

# Native LP64 layout with one DS and one RRA: pdp_step at 40, ds_nam at
# 128, rra_def[0].cf_nam at 248 and pdp_cnt at 280, pdp_prep[0].last_ds at
# 384, rra_ptr[0].cur_row at 576.
check () {
  local what="$1" edit="$2" pattern="$3"
  cp "${BUILD}.rrd" "${BUILD}-crafted.rrd"
  perl -0777 -pi -e "$edit" "${BUILD}-crafted.rrd"
  for command in info first update; do
    case "$command" in
      info|first) args=() ;;
      update) args=(900000060:1) ;;
    esac
    $RRDTOOL "$command" "${BUILD}-crafted.rrd" "${args[@]}" >"${BUILD}.out" 2>&1
    status=$?
    [ "$status" -ne 0 ] && [ "$status" -lt 128 ] || \
      fail 1 "$what: $command exit status $status: $(cat "${BUILD}.out")"
    grep -q "$pattern" "${BUILD}.out" || \
      fail 1 "$what: $command was not diagnosed: $(cat "${BUILD}.out")"
  done
  ok "$what"
}

# 2^32 * 2^32 wraps to 0, and rrd_first divides by the product.
check "reject pdp_cnt * pdp_step overflow" \
  'substr($_, 40, 8, pack("Q", 1 << 32)); substr($_, 280, 8, pack("Q", 1 << 32))' \
  "pdp_cnt 4294967296 is too large for step 4294967296"

check "reject cur_row past row_cnt" \
  'substr($_, 576, 8, pack("Q", 5))' \
  "cur_row 5 is past its 2 rows"

check "reject an unterminated DS name" \
  'substr($_, 128, 20, "a" x 20)' \
  "unterminated name or type"

check "reject an unterminated CF name" \
  'substr($_, 248, 20, "A" x 20)' \
  "unterminated CF name"

check "reject an unterminated last_ds" \
  'substr($_, 384, 30, "1" x 30)' \
  "unterminated last_ds"

$RRDTOOL info "${BUILD}.rrd" >/dev/null
report "the unmodified file still opens"

rm -f "${BUILD}"*.rrd "${BUILD}.out"
