#!/bin/bash

. "$(dirname "$0")/functions"

require_restore
# A parse error inside a value made xmlTextReaderRead return -1 on every
# call, and get_xml_text looped on it forever. restore must fail instead.
# The input is what the restore fuzzer reduced it to: a dump cut short,
# with 121 0xE1 bytes (not UTF-8) where a value is expected.
BUILD="$BUILDDIR/$(basename "$0")"

rm -f "${BUILD}.rrd"
perl -pe 's/\@BAD\@/"\xe1" x 121/e' > "${BUILD}.xml" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE rrd SYSTEM "https://oss.oetiker.ch/rrdtool/rrdtool.dtd">
<!-- Round Robin Database Dump -->
<rrd>
	<version>0002</version>
	<step>300</step> <!-- Seconds -->
	<lastupdate>900000600</lastupdate> <!-- 1998-07-09 09:10C00 -0700 -->

	<ds>
		<name> in </name>
		<type> COUNTER </type>
		<minimal_heartbeat>600</minimal_heartbeat>
		<min>0.0000000000e+070</min>
		<max>NaN</max>

		<!-- PDP Status -->
		<last_ds>15</last_ds>
		<value><!-- PDP Status -->
		<@BAD@last_ds>25</last_ds>
atabase>
	</rra>
</rrd>
XML
[ "$(wc -c < "${BUILD}.xml")" -eq 668 ]
report "write the malformed dump"

rm -f "${BUILD}.hung"
# $RRDTOOL can be a shell function (TESTS_STYLE=rrdcached-*), which timeout(1)
# cannot run, so watch it from the shell instead.
$RRDTOOL restore "${BUILD}.xml" "${BUILD}.rrd" >"${BUILD}.out" 2>&1 &
RESTORE_PID=$!
( sleep 60; kill -9 $RESTORE_PID 2>/dev/null && touch "${BUILD}.hung" ) &
WATCHDOG_PID=$!
wait $RESTORE_PID
status=$?
kill $WATCHDOG_PID 2>/dev/null
wait $WATCHDOG_PID 2>/dev/null
if [ -e "${BUILD}.hung" ]; then
  fail 1 "restore of malformed XML did not finish"
elif [ "$status" -eq 0 ] || [ "$status" -ge 128 ]; then
  fail 1 "restore of malformed XML: exit status $status"
elif ! grep -q "XML parse error while looking for text" "${BUILD}.out"; then
  fail 1 "restore of malformed XML: $(cat "${BUILD}.out")"
else
  ok "restore of malformed XML fails"
fi

rm -f "${BUILD}.rrd" "${BUILD}.xml" "${BUILD}.out" "${BUILD}.hung"
